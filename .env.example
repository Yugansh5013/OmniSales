# ============================================================
# OmniSales — Environment Variables
# Copy to .env and fill in your keys
# ============================================================

# --- LLM (Groq) ---
# Comma-separated for key rotation pool
GROQ_API_KEYS=gsk_YOUR_KEY_1,gsk_YOUR_KEY_2

# --- Database (Neon Cloud PostgreSQL) ---
DATABASE_URL=postgresql://neondb_owner:<your_password>@ep-<your-endpoint>.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_PROJECT_ID=small-lake-37805230
NEON_BRANCH_ID=br-frosty-cherry-a15xoyq0

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Kafka ---
KAFKA_BROKERS=kafka:9092

# --- Pinecone (RAG) ---
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=omnisales-knowledge

# --- OpenAI Embeddings (for Pinecone) ---
OPENAI_API_KEY=your_openai_api_key

# --- LangSmith Observability (optional) ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=omnisales

# --- Multi-tenant ---
ORG_ID=org_default

# --- HubSpot CRM Integration (Optional for live bidirectional sync) ---
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_PORTAL_ID=12345678

# --- MCP Server URLs ---
MCP_APPROVALS_URL=http://mcp-approvals:8004/mcp
MCP_KNOWLEDGE_URL=http://mcp-knowledge:8003/mcp
MCP_CRM_URL=http://mcp-crm:8001/mcp

# --- A2A ---
SPY_A2A_URL=http://spy-a2a:8080

# --- JWT Auth ---
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# --- Razorpay (Payment Links & Invoices) ---
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# --- Resend (Email Delivery) ---
RESEND_API_KEY=re_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev
DEMO_NOTIFICATION_EMAIL=sales-demo@example.com

# --- Inbound reply polling (Closer only — reply-to-a-demo-email triggers re-classification) ---
GMAIL_IMAP_USER=sales-demo@example.com
GMAIL_IMAP_APP_PASSWORD=your_16_char_app_password

# --- Tavily (Spy Agent — live competitor web search) ---
TAVILY_API_KEY=tvly-your_key_here

# --- IMAP (Reply Watcher) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_inbox@gmail.com
IMAP_PASSWORD=your_app_password

